.idea
.hugo_build.lock
# Root only: an unanchored `data` also matches static/data, which is the
# scene data the illustrations load.
/data
public
resources
themes
# notebook render output and caches
notebooks/results/
**/.ipynb_checkpoints/
__pycache__/
site/

# Notebook outputs belong in notebooks/results/, ignored above. These catch
# anything a notebook drops beside itself instead - which is how 8 MB of PNGs
# and MP4s once got committed.
/notebooks/*.png
/notebooks/*.jpg
/notebooks/*.mp4
/notebooks/*.gif
/notebooks/*.ply
/notebooks/*.stl
/notebooks/*.gltf
/notebooks/*.zarr/

# Downloaded model weights, fetched on demand by the figure scripts.
/tools/.cache/
